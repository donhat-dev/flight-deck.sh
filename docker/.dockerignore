# Build context is the repo root (compose: context: ..). BuildKit reads this as
# docker/Dockerfile.dockerignore is not present; keep this list repo-root-relative.
# Patterns exclude host cruft from the context so the image build stays lean.
.git/
.venv/
.superpowers/
docs/
python/audit.db
python/audit.db-wal
python/audit.db-shm
audit.db
audit.db-wal
audit.db-shm
__pycache__/
*.pyc
.pytest_cache/
node_modules/
clients/web/node_modules/
clients/web/dist/
