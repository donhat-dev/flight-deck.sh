<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="flight_deck.TranscriptBox">
        <div class="fd_box" t-att-class="props.class">
            <div class="fd_box_head">
                <span class="fd_box_count">
                    <t t-esc="shown.length"/> of <t t-esc="state.total"/> lines
                </span>
                <span t-if="state.runtime and !watching" t-attf-class="fd_box_state fd_box_state_{{state.runtime}}"
                      t-att-title="state.runtimeError" t-esc="state.runtime"/>
                <select class="fd_box_turn" t-if="state.turns.length and !state.peersOnly"
                        t-on-focus="() => this.loadTurns()"
                        t-on-change="(ev) => this.pickTurn(ev.target.value)">
                    <option value="0">All turns</option>
                    <!-- Not `turn`: a loop name that matches a getter on this
                         component resolves to the getter, and every option came
                         out carrying the current turn's number. -->
                    <option t-foreach="state.turns" t-as="listed" t-key="listed.index"
                            t-att-value="listed.index"
                            t-att-selected="listed.index === state.turnIndex"
                            t-esc="turnLabel(listed)"/>
                </select>
                <span class="fd_box_spacer"/>
                <button class="fd_box_chip" t-att-class="{ 'fd_off': state.view !== 'transcript' }"
                        t-on-click="() => this.showView('transcript')">Transcript</button>
                <button class="fd_box_chip" t-att-class="{ 'fd_off': state.view !== 'gantt' }"
                        t-att-disabled="!turn"
                        t-on-click="() => this.showView('gantt')">Gantt</button>
                <button class="fd_box_chip" t-if="state.view === 'transcript'"
                        t-att-class="{ 'fd_off': !roles.user }"
                        t-on-click="() => this.toggleRole('user')">User</button>
                <button class="fd_box_chip" t-if="state.view === 'transcript'"
                        t-att-class="{ 'fd_off': !roles.assistant }"
                        t-on-click="() => this.toggleRole('assistant')">Claude</button>
                <button class="fd_box_chip" t-if="state.view === 'transcript'"
                        t-att-class="{ 'fd_off': !state.peersOnly }"
                        title="Only the messages exchanged with other sessions, across every turn"
                        t-on-click="() => this.togglePeers()">Sessions</button>
            </div>

            <!-- Where the turn spent its time. Laid out on the gap between one
                 line and the next, which is what the transcript records. The
                 solid part of a bar is the tool itself, known once the turn's
                 tool calls are read. -->
            <div t-if="state.view === 'gantt'" class="fd_gantt">
                <t t-set="counts" t-value="chartCounts"/>
                <div class="fd_gantt_head">
                    <span t-esc="chart.length"/> steps ·
                    <span t-esc="chartTotal"/> ·
                    <span t-esc="counts.errors"/> errors ·
                    <span t-esc="counts.blocked"/> blocked ·
                    <span t-esc="counts.repeats"/> exact repeats
                    <span class="fd_gantt_legend">
                        <span t-if="counts.read"><i class="fd_gantt_key fd_gantt_key_tool"/>tool</span>
                        <span><i class="fd_gantt_key"/><t t-if="counts.read">thinking or waiting</t><t t-else="">until the next line</t></span>
                        <span><i class="fd_gantt_key fd_gantt_key_error"/>error</span>
                        <span><i class="fd_gantt_key fd_gantt_key_guard"/>blocked</span>
                        <span>↻ repeat</span>
                    </span>
                    <div t-if="!counts.read and chart.length" class="fd_gantt_note">
                        This turn's tool calls are not read yet, so errors and tool time are missing.
                    </div>
                </div>
                <div t-if="state.stepsLoading" class="fd_box_empty">Loading…</div>
                <div t-elif="!chart.length" class="fd_box_empty">
                    This turn wrote nothing with a timestamp to lay out.
                </div>
                <div t-else="" class="fd_gantt_rows">
                    <div t-foreach="chart" t-as="step" t-key="step.seq"
                         t-attf-class="fd_gantt_row {{step.family ? 'fd_gantt_f_' + step.family : ''}}">
                        <span class="fd_gantt_name" t-att-title="step.title">
                            <t t-esc="step.tool_name"/><span t-if="step.repeat" class="fd_gantt_rep"> ↻</span>
                        </span>
                        <span class="fd_gantt_track">
                            <span t-attf-class="fd_gantt_bar {{step.heavy ? 'fd_gantt_heavy' : ''}}"
                                  t-attf-style="left: {{step.left}}%; width: {{step.width}}%"
                                  t-att-title="step.title">
                                <span t-if="step.toolPct != null" class="fd_gantt_tool"
                                      t-attf-style="width: {{step.toolPct}}%"/>
                            </span>
                        </span>
                        <span class="fd_gantt_spent" t-esc="step.spent"/>
                    </div>
                </div>
            </div>

            <div t-if="state.view === 'transcript'" class="fd_box_scroll"
                 t-ref="scroller" t-on-scroll="onScroll">
                <div t-if="state.loading" class="fd_box_empty">Loading…</div>
                <t t-else="">
                    <!-- The newest thing on screen: not yet a real row, so no
                         id and no buttons. The scroller is column-reverse, so
                         this has to sit before the real rows in DOM order to
                         land below the newest of them. -->
                    <div t-if="!watching and state.streamDraft" class="fd_bubble fd_bubble_assistant fd_bubble_draft">
                        <div class="fd_bubble_head">
                            <span class="fd_bubble_role">assistant</span>
                        </div>
                        <div class="fd_bubble_text fd_md" t-out="streamDraftBody"/>
                    </div>
                    <div t-foreach="shown" t-as="line" t-key="line.id"
                         t-attf-class="fd_bubble fd_bubble_{{line.role}}">
                        <div class="fd_bubble_head">
                            <span class="fd_bubble_role" t-esc="line.role"/>
                            <span t-if="line.role === 'peer'" class="fd_bubble_from" t-esc="peerLabel(line)"/>
                            <span class="fd_bubble_seq" t-esc="line.seq"/>
                            <span class="fd_bubble_ts" t-esc="stamp(line.ts)"/>
                        </div>
                        <div t-if="line.text" class="fd_bubble_text fd_md" t-out="bodyOf(line)"/>

                        <div t-if="line.tool_input" class="fd_tool">
                            <div class="fd_tool_head">
                                <span class="fd_tool_name" t-esc="line.tool_name or 'tool'"/>
                                <span class="fd_tool_spacer"/>
                                <button class="fd_tool_toggle"
                                        t-on-click="() => this.toggleInput(line.id)">
                                    <t t-if="state.open[line.id]">Collapse</t>
                                    <t t-else="">Expand</t>
                                </button>
                            </div>
                            <pre t-attf-class="fd_tool_in {{ state.open[line.id] ? '' : 'fd_clamp' }}"
                                 t-esc="line.tool_input"/>
                            <t t-component="rendererOf(line)"
                               t-props="{ line: line, open: !!state.open[line.id] }"/>
                        </div>
                    </div>
                    <div t-if="!shown.length" class="fd_box_empty">No turns to show.</div>
                    <button t-if="hasOlder" class="fd_box_older" t-on-click="() => this.loadOlder()">
                        Load older turns
                    </button>
                </t>
            </div>

            <!-- The process is parked while this is on screen: the runner is
                 holding the CLI's request open until one of these buttons
                 answers it, or its own timeout does. -->
            <div t-if="ask and !watching" class="fd_ask" tabindex="0" t-ref="ask" t-on-keydown="onAskKeydown">
                <div class="fd_ask_head">
                    <span class="fd_ask_badge">Permission</span>
                    <span class="fd_ask_tool" t-esc="ask.tool_name"/>
                    <span class="fd_box_spacer"/>
                    <span t-if="state.asks.length > 1" class="fd_ask_more">
                        +<t t-esc="state.asks.length - 1"/> more waiting
                    </span>
                </div>
                <div t-if="ask.summary" class="fd_ask_summary" t-esc="ask.summary"/>
                <div t-if="ask.description" class="fd_ask_desc" t-esc="ask.description"/>
                <div t-if="ask.blocked_path" class="fd_ask_path">
                    Reaches outside the working directory: <span t-esc="ask.blocked_path"/>
                </div>
                <pre t-if="ask.tool_input" class="fd_ask_input" t-esc="ask.tool_input"/>
                <div class="fd_ask_actions">
                    <button class="btn btn-primary btn-sm" t-att-disabled="state.deciding"
                            t-on-click="() => this.decide('allow', 'once')">Allow</button>
                    <button class="btn btn-secondary btn-sm" t-att-disabled="state.deciding"
                            t-on-click="() => this.decide('allow', 'session')">Allow for this session</button>
                    <button t-if="ask.can_remember" class="btn btn-secondary btn-sm"
                            t-att-disabled="state.deciding"
                            t-on-click="() => this.decide('allow', 'always')">Always allow</button>
                    <span class="fd_box_spacer"/>
                    <button class="btn btn-outline-danger btn-sm" t-att-disabled="state.deciding"
                            t-on-click="() => this.decide('deny')">Deny</button>
                </div>
                <div class="fd_ask_hint">Enter allows once, Escape denies.</div>
            </div>

            <!-- Sending only queues the turn for the runner; the reply arrives
                 over the bus like any other turn, and the state chip above says
                 what the process is doing meanwhile. -->
            <div t-if="!watching" class="fd_box_compose">
                <div t-if="state.error" class="fd_box_error" t-esc="state.error"/>
                <div t-if="!state.error and state.runtimeError" class="fd_box_error" t-esc="state.runtimeError"/>
                <textarea class="fd_box_input" rows="1" t-ref="draft"
                          t-att-disabled="state.sending or !props.resId"
                          t-model="state.draft"
                          t-on-keydown="onKeydown"
                          title="Enter sends, Shift+Enter starts a new line."
                          t-att-placeholder="placeholder"/>
                <div class="fd_box_bar">
                    <select class="fd_box_mode" t-on-change="setMode"
                            title="What Claude may do without asking. Takes effect on the next turn.">
                        <option t-foreach="modes" t-as="mode" t-key="mode[0]"
                                t-att-value="mode[0]" t-att-selected="state.mode === mode[0]"
                                t-esc="mode[1]"/>
                    </select>
                    <span t-if="state.modeSaving" class="fd_box_hint">saving…</span>
                    <div class="fd_box_picker">
                        <button class="fd_box_badge" t-on-click.stop="togglePicker"
                                title="Which model answers, and how hard it works.">
                            <t t-esc="modelLabel"/>
                            <span t-if="effortLabel" class="fd_box_badge_effort" t-esc="effortLabel"/>
                        </button>
                        <div t-if="state.picking" class="fd_box_menu" t-on-click.stop="">
                            <div class="fd_box_menu_head">Select a model</div>
                            <button t-foreach="state.models" t-as="m" t-key="m.value"
                                    class="fd_box_menu_item"
                                    t-att-class="{ fd_on: state.model === m.value }"
                                    t-on-click="() => this.pickModel(m.value)">
                                <span class="fd_box_menu_label">
                                    <t t-esc="m.label"/>
                                    <span t-if="state.model === m.value" class="fd_box_menu_tick">✓</span>
                                </span>
                                <span class="fd_box_menu_note" t-esc="m.note"/>
                            </button>
                            <div class="fd_box_menu_head">
                                Effort
                                <span class="fd_box_menu_note">
                                    Changing this on a running session costs one turn.
                                </span>
                            </div>
                            <div class="fd_box_menu_efforts">
                                <button t-foreach="state.efforts" t-as="e" t-key="e.value"
                                        class="fd_box_menu_pill"
                                        t-att-class="{ fd_on: state.effort === e.value }"
                                        t-on-click="() => this.pickEffort(e.value)"
                                        t-esc="e.label"/>
                            </div>
                        </div>
                    </div>
                    <span class="fd_box_spacer"/>
                    <button class="fd_box_send" t-on-click="() => this.send()"
                            t-att-disabled="state.sending or !state.draft.trim()">
                        <t t-if="state.sending">Sending…</t>
                        <t t-else="">Send</t>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
