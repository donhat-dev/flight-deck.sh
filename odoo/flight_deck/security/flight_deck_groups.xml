<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_flight_deck" model="ir.module.category">
        <field name="name">FlightDeck</field>
        <field name="sequence">50</field>
    </record>

    <!-- Odoo 19 puts the category on a privilege record; res.groups points at it. -->
    <record id="privilege_flight_deck" model="res.groups.privilege">
        <field name="name">FlightDeck</field>
        <field name="category_id" ref="module_category_flight_deck"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Reader</field>
        <field name="privilege_id" ref="privilege_flight_deck"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_flight_deck"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>
</odoo>
