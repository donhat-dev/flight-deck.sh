<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- List API rates from platform.claude.com/docs/en/about-claude/pricing,
         read 2026-09-23. A model with no row here stays unpriced: a missing
         number reads as unknown, a neighbour's number reads as a real cost.
         noupdate: an existing database takes rate changes through a migration
         (migrations/19.0.1.1.0), not through this file. -->
    <record id="price_opus_5_5" model="flightdeck.model.price">
        <field name="name">claude-opus-5-5</field>
        <field name="input_rate">4.0</field>
