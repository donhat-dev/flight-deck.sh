<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_follow" model="ir.cron">
        <field name="name">FlightDeck: read followed transcripts</field>
        <field name="model_id" ref="model_flightdeck_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_follow()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <!-- One minute is the floor Odoo's scheduler allows, and it is only the
             safety net: the watcher triggers this job as soon as a file grows. -->
    </record>
</odoo>
