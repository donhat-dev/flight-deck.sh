<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="1">

	<record id="provider_llm_connector" model="muk_ai.provider">
		<field name="name">flight_llm_connector</field>
		<field name="sequence">5</field>
		<field name="flight_connector_id" ref="workflow_connector_llm.connector_llm"/>
	</record>

	<record id="model_llm_connector_default" model="muk_ai.model">
		<field name="name">DeepSeek V4.1 Flash (free)</field>
		<field name="provider_id" ref="provider_llm_connector"/>
		<field name="technical_name">opencode/deepseek-v4.1-flash-free</field>
		<field name="context_window">128000</field>
		<!-- The bridge's default model is free; rates of 0 keep the cost ledger honest. -->
		<field name="input_rate">0.0</field>
		<field name="output_rate">0.0</field>
		<field name="notes">The OpenCode bridge's default model.</field>
	</record>

	<record id="provider_llm_connector" model="muk_ai.provider">
		<field name="default_chat_model_id" ref="model_llm_connector_default"/>
	</record>

</odoo>
