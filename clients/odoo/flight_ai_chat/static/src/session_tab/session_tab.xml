<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="flight_ai_chat.FlightSessionTab">
        <div class="o_flight_session_tab h-100 overflow-auto p-3 d-flex flex-column gap-3">
            <div>
                <div class="small fw-semibold text-muted mb-1">Screen</div>
                <div class="small" t-esc="screenLabel"/>
            </div>
            <div>
                <div class="small fw-semibold text-muted mb-1">Tools</div>
                <FlightToolsPopover
                    t-key="sessionId + '-' + (agentId || 0)"
                    sessionId="sessionId"
                    agentId="agentId"
                    inline="true"
                />
            </div>
        </div>
    </t>

</templates>
