<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_muk_ai_provider_form_flight" model="ir.ui.view">
		<field name="name">muk_ai.provider.form.flight_ai_chat</field>
		<field name="model">muk_ai.provider</field>
		<field name="inherit_id" ref="muk_ai.view_muk_ai_provider_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='api_key']" position="attributes">
				<attribute name="invisible">name == 'flight_llm_connector'</attribute>
			</xpath>
			<xpath expr="//field[@name='api_key']" position="after">
				<field
					name="flight_connector_id"
					invisible="name != 'flight_llm_connector'"
				/>
				<field
					name="flight_account_id"
					invisible="name != 'flight_llm_connector'"
				/>
			</xpath>
			<xpath expr="//field[@name='api_region']" position="attributes">
				<attribute name="invisible">name == 'flight_llm_connector' or not api_region_options</attribute>
			</xpath>
			<xpath expr="//field[@name='api_url']" position="attributes">
				<attribute name="invisible">name == 'flight_llm_connector' or api_region != 'custom'</attribute>
			</xpath>
		</field>
	</record>

</odoo>
