<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_session_list" model="ir.ui.view">
        <field name="name">flightdeck.session.list</field>
        <field name="model">flightdeck.session</field>
        <field name="arch" type="xml">
            <list string="Logbook" create="0" default_order="last_write desc"
                  js_class="flight_deck_logbook_list">
                <header>
                    <button name="action_scan_now" type="object" display="always"
                            string="Scan now"/>
                </header>
                <field name="last_write"/>
                <field name="write_date" string="Row touched" optional="hide"/>
                <field name="start_ts" optional="show"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="message_count" sum="Messages"/>
                <field name="tool_call_count" sum="Tool calls"/>
                <field name="duration_hours" string="Span (h)" sum="Span" optional="hide"/>
                <field name="work_hours" sum="Work-hours" widget="float_time"/>
                <field name="total_cost" sum="Cost"/>
                <field name="runtime_state" optional="show"/>
                <field name="following" optional="show" widget="boolean_toggle"/>
                <field name="session_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_session_form" model="ir.ui.view">
        <field name="name">flightdeck.session.form</field>
        <field name="model">flightdeck.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                <header>
                    <button name="action_recompute_totals" type="object"
                            string="Recompute totals" class="btn-secondary"/>
                    <button name="action_rescan_spend" type="object"
                            string="Reread spend" class="btn-secondary"/>
                    <button name="action_open_channel" type="object"
                            string="Open in Discuss" class="btn-secondary"/>
                    <button name="action_start_runtime" type="object" string="Start"
                            class="btn-primary" invisible="not runner_id or runtime_state != 'stopped'"/>
                    <button name="action_interrupt_runtime" type="object" string="Interrupt"
                            class="btn-secondary" invisible="runtime_state != 'busy'"/>
                    <button name="action_stop_runtime" type="object" string="Stop"
                            class="btn-secondary" invisible="runtime_state == 'stopped'"/>
                    <field name="runtime_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Two buttons rather than one: the icon is an attribute,
                             so the open eye and the crossed one cannot be the
                             same element. -->
                        <button name="action_toggle_following" type="object"
                                class="oe_stat_button text-success" icon="fa-eye"
                                invisible="not following">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Following</span>
                            </div>
                        </button>
                        <button name="action_toggle_following" type="object"
                                class="oe_stat_button text-danger" icon="fa-eye-slash"
                                invisible="following">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Not following</span>
                            </div>
                        </button>
                        <button name="action_open_messages" type="object"
                                class="oe_stat_button" icon="fa-dollar">
                            <field name="total_cost" widget="statinfo" string="Cost"/>
                        </button>
                        <button name="action_open_decisions" type="object"
                                class="oe_stat_button" icon="fa-hand-paper-o"
                                invisible="not pending_decision_count">
                            <field name="pending_decision_count" widget="statinfo" string="Waiting"/>
                        </button>
                        <button name="action_open_transcript" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <field name="text_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button name="action_open_messages" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="session_id" readonly="1"/>
                        <field name="following" invisible="1"/>
                    </div>
                    <notebook>
                        <page string="Agents" name="agents">
                            <div class="fd_org_actions">
                                <button name="action_rebuild_agents" type="object"
                                        string="Rebuild map" class="btn-secondary"/>
                                <field name="map_from_start" widget="boolean_toggle"/>
                            </div>
                            <field name="agent_ids" widget="fd_agent_map" nolabel="1"/>
                        </page>
                        <page string="General" name="general">
                            <group>
                                <group>
                                    <field name="project_id"/>
                                    <field name="start_ts"/>
                                    <field name="end_ts"/>
                                    <field name="duration_hours"/>
                                    <field name="title_source"/>
                                    <field name="follow_path" invisible="not follow_path"/>
                                </group>
                                <group>
                                    <field name="input_tokens"/>
                                    <field name="output_tokens"/>
                                    <field name="cache_read"/>
                                    <field name="cache_create"/>
                                    <field name="tool_call_count"/>
                                    <field name="treasure_count"/>
                                </group>
                            </group>
                        </page>
                        <page string="Usage" name="usage">
                            <separator string="Tool calls"/>
                            <field name="tool_call_ids" nolabel="1">
                                <list create="0">
                                    <field name="ts"/>
                                    <field name="tool"/>
                                    <field name="server"/>
                                    <field name="detail"/>
                                </list>
                            </field>
                            <separator string="Tokens and cost"/>
                            <field name="usage_ids" nolabel="1">
                                <list create="0">
                                    <field name="ts"/>
                                    <field name="model"/>
                                    <field name="input_tokens" sum="Input"/>
                                    <field name="cache_read" sum="Cache read"/>
                                    <field name="output_tokens" sum="Output"/>
                                    <field name="cost" sum="Cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Treasures" name="treasures">
                            <field name="treasure_ids" nolabel="1">
                                <list create="0">
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="status"/>
                                    <field name="authored_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Settings" name="settings">
                            <group>
                                <group string="Runtime" name="runtime">
                                    <field name="runner_id"/>
                                    <field name="cwd" placeholder="Taken from the transcript, else the runner default"/>
                                    <field name="live_permission_mode"/>
                                    <field name="live_model"/>
                                    <field name="live_effort"/>
                                    <field name="allow_live"/>
                                    <field name="runner_pid" invisible="not runner_pid"/>
                                    <field name="runner_cost"/>
                                    <field name="runtime_error" invisible="not runtime_error"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Compiled into the side pane by our own form compiler, the
                     same way mail turns `o_attachment_preview` into a viewer. -->
                <div class="o_fd_transcript"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_session_search" model="ir.ui.view">
        <field name="name">flightdeck.session.search</field>
        <field name="model">flightdeck.session</field>
        <field name="arch" type="xml">
            <search string="Logbook">
                <field name="name"/>
                <field name="session_id"/>
                <field name="project_id"/>
                <filter name="following" string="Following" domain="[('following','=',True)]"/>
                <filter name="this_month" string="This month" date="start_ts"/>
                <separator/>
                <!-- What the dashboard tiles apply: sessions written in the period. -->
                <filter name="written_today" string="Written today"
                        domain="[('last_write', '>=', datetime.datetime.combine(context_today(), datetime.time(0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="written_week" string="Written this week"
                        domain="[('last_write', '>=', (datetime.datetime.combine(context_today(), datetime.time(0, 0)) - relativedelta(days=context_today().weekday())).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="written_month" string="Written this month"
                        domain="[('last_write', '>=', datetime.datetime.combine(context_today().replace(day=1), datetime.time(0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <group>
                    <filter name="g_project" string="Project" domain="[]" context="{'group_by':'project_id'}"/>
                    <filter name="g_day" string="Day" domain="[]" context="{'group_by':'start_ts:day'}"/>
                    <filter name="g_write" string="Last write" domain="[]" context="{'group_by':'write_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logbook" model="ir.actions.act_window">
        <field name="name">Logbook</field>
        <field name="res_model">flightdeck.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_session_search"/>
    </record>
</odoo>
