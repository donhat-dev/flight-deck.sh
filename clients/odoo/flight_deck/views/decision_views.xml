<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_decision_list" model="ir.ui.view">
        <field name="name">flightdeck.decision.list</field>
        <field name="model">flightdeck.decision</field>
        <field name="arch" type="xml">
            <list string="Permission requests" create="0"
                  decoration-warning="state == 'pending'"
                  decoration-muted="state == 'expired'">
                <field name="create_date" string="Asked"/>
                <field name="session_ref_id"/>
                <field name="tool_name"/>
                <field name="summary"/>
                <field name="state"/>
                <field name="scope" optional="show"/>
                <field name="decided_by" optional="show"/>
                <field name="waited_ms" optional="hide"/>
                <button name="action_allow" type="object" string="Allow"
                        class="btn-primary" invisible="state != 'pending'"/>
                <button name="action_deny" type="object" string="Deny"
                        class="btn-secondary" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_decision_form" model="ir.ui.view">
        <field name="name">flightdeck.decision.form</field>
        <field name="model">flightdeck.decision</field>
        <field name="arch" type="xml">
            <form string="Permission request" create="false">
                <header>
                    <button name="action_allow" type="object" string="Allow"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_allow_always" type="object" string="Always allow"
                            class="btn-secondary"
                            invisible="state != 'pending' or not can_remember"/>
                    <button name="action_deny" type="object" string="Deny"
                            class="btn-secondary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="tool_name" readonly="1"/></h1>
                        <field name="summary" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="session_ref_id" readonly="1"/>
                            <field name="runner_id" readonly="1"/>
                            <field name="can_remember" readonly="1"/>
                            <field name="blocked_path" readonly="1" invisible="not blocked_path"/>
                        </group>
                        <group>
                            <field name="scope"/>
                            <field name="decided_by" readonly="1"/>
                            <field name="decided_at" readonly="1"/>
                            <field name="waited_ms" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" readonly="1" invisible="not description"/>
                    <field name="tool_input" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_decision" model="ir.actions.act_window">
        <field name="name">Permission requests</field>
        <field name="res_model">flightdeck.decision</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_decision_pending" model="ir.actions.act_window">
        <field name="name">Waiting for approval</field>
        <field name="res_model">flightdeck.decision</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
    </record>
</odoo>
